rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Legacy v1 Tracker Document Validation (backward-compatible with woopp-tracker v1)
    function isValidLegacyTracker(data) {
      return data.keys().hasAll(['colors', 'machines', 'jobs', 'log']) &&
        data.keys().hasOnly(['colors', 'machines', 'jobs', 'log']) &&
        data.colors is list && data.colors.size() <= 20 &&
        data.machines is list && data.machines.size() <= 100 &&
        data.jobs is list && data.jobs.size() <= 2000 &&
        data.log is list && data.log.size() <= 500;
    }

    // WOOPP 5.0 Workspace Validation Blueprint (supports Smart ETA & Machine Scheduling + serverUpdatedAt)
    function isValidWorkspaceV5(data, userId) {
      return data.keys().hasAll([
          'schemaVersion',
          'ownerId',
          'migratedFromV1',
          'colors',
          'machines',
          'projects',
          'jobs',
          'presets',
          'inventory',
          'log',
          'settings',
          'updatedIso'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion',
          'ownerId',
          'migratedFromV1',
          'colors',
          'machines',
          'projects',
          'jobs',
          'presets',
          'inventory',
          'log',
          'settings',
          'updatedIso',
          'serverUpdatedAt'
        ]) &&
        data.schemaVersion == 5 &&
        data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == userId &&
        data.migratedFromV1 is bool &&
        data.colors is list && data.colors.size() <= 50 &&
        data.machines is list && data.machines.size() <= 100 &&
        data.projects is list && data.projects.size() <= 500 &&
        data.jobs is list && data.jobs.size() <= 3000 &&
        data.presets is list && data.presets.size() <= 100 &&
        data.inventory is map &&
        data.log is list && data.log.size() <= 500 &&
        data.settings is map &&
        data.updatedIso is string && data.updatedIso.size() <= 64 &&
        (!('serverUpdatedAt' in data) || data.serverUpdatedAt == request.time);
    }

    // Preserved v1 document path: users/{userId}/tracker/main
    match /users/{userId}/tracker/main {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidLegacyTracker(incoming());
      allow update: if isOwner(userId) && isValidLegacyTracker(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['colors', 'machines', 'jobs', 'log']);
      allow delete: if false;
    }

    // WOOPP 5.0 Workspace document path: users/{userId}/tracker/v5_workspace
    match /users/{userId}/tracker/v5_workspace {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWorkspaceV5(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidWorkspaceV5(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'schemaVersion',
          'migratedFromV1',
          'colors',
          'machines',
          'projects',
          'jobs',
          'presets',
          'inventory',
          'log',
          'settings',
          'updatedIso',
          'serverUpdatedAt'
        ]);
      allow delete: if false;
    }
  }
}
